  "strings": {
    "research": {
      "fubeesgenetics_industrial_beekeeping": [
        "Industrial Beekeeping",
        "^orange;Tier 5 - Bee Abusive Industry^reset;\n\nThe tedium of tending bees and sorting queens by hand has driven you to seek better methods. Automated genetic selection and resource exchange turn repetitive work into a reliable process."
      ],
      "fubeesgenetics_abusive_apiaries": [
        "Abusive Apiaries",
        "^orange;Tier 6 - Bee Abusive Industry^reset;\n\nYou have grown less sensitive to the bees' welfare. By pushing them to work harder, your powered apiaries increase output at the cost of a queen's working life."
      ],
      "fubeesgenetics_unethical_genetics": [
        "Unethical Genetic Practices",
        "^orange;Tier 7 - Bee Abusive Industry^reset;\n\nYou are ready to manipulate bee genetics in ways traditional beekeeping has left unexplored for ethical and environmental reasons. Crossing distinct species may produce new lineages, but success is far from certain."
      ]
    }
  }
